Host *
    ControlMaster auto
    # %C = hash of local/remote/port/user — avoids case quirks (mixed-case usernames)
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
    IdentityFile ~/.ssh/id_ed25519

# Per-machine hosts (not in git). Create with:
#   touch ~/.ssh/config.local && chmod 600 ~/.ssh/config.local
Include config.local
