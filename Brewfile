# Homebrew packages for a new Mac. Install with: brew bundle --file=Brewfile
# Kept lean: shell core + tools the configs expect + media utilities.

# --- Shell & editor ---
brew "zsh"
brew "bash"
brew "tmux"
brew "vim"
brew "git"

# --- GNU userland (paths.zsh puts these on PATH) ---
brew "coreutils"
brew "findutils"
brew "gnu-sed"
brew "grep"

# --- Search & navigation ---
brew "fd"
brew "fzf"
brew "ripgrep"

# --- Everyday CLI ---
brew "rsync"
brew "tree"
brew "p7zip"
brew "python"
brew "rename"
brew "tag"
brew "mupdf"
brew "ntfy"

# --- Media / photo / video ---
brew "exiftool"
brew "media-info"
brew "imagemagick"
brew "yt-dlp"
